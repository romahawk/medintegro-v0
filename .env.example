# Medintegro - Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.

# ---------------------------------------------------------------------------
# Email (Resend) - required for contact form submission
# Get your key at: https://resend.com/api-keys
# ---------------------------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The email address that receives contact form submissions
CONTACT_EMAIL=hello@medintegro.com

# ---------------------------------------------------------------------------
# Site URL - used for Open Graph tags and sitemap generation
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.medintegro.com.ua

# ---------------------------------------------------------------------------
# Chat widget (optional)
# Set the provider and Website ID before enabling the launcher action.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CHAT_WIDGET_ENABLED=false
NEXT_PUBLIC_CHAT_PROVIDER=crisp
NEXT_PUBLIC_CRISP_WEBSITE_ID=

# ---------------------------------------------------------------------------
# Analytics (optional)
# Vercel Analytics is enabled by default via @vercel/analytics
# No key needed - it auto-detects in Vercel deployments
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX   # Optional: Google Analytics 4
